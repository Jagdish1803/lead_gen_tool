# ── Supabase Postgres ───────────────────────────────────────
# From Supabase: Project → Connect → ORMs (or Database settings).
# Transaction-mode pooler (pgbouncer) — app runtime queries.
DATABASE_URL="postgresql://postgres.YOUR-REF:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session-mode pooler — DDL / migrations / applying schema.sql.
DIRECT_URL="postgresql://postgres.YOUR-REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres"

# ── SerpApi (Phase 1: Finder) ───────────────────────────────
# https://serpapi.com/manage-api-key
SERPAPI_KEY="your-serpapi-key"

# ── AI provider (Phase 3: Writer) — decided later ───────────
# ANTHROPIC_API_KEY="..."

# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
