# ── Supabase Postgres ───────────────────────────────────────
# From Supabase: Project → Connect → ORMs (or Database settings).
# Transaction-mode pooler (pgbouncer) — app runtime queries.
DATABASE_URL="postgresql://postgres.YOUR-REF:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session-mode pooler — DDL / migrations / applying schema.sql.
DIRECT_URL="postgresql://postgres.YOUR-REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres"

# ── SerpApi (Phase 1: Finder) ───────────────────────────────
# https://serpapi.com/manage-api-key
SERPAPI_KEY="your-serpapi-key"

# ── PageSpeed (Phase 2: Auditor) — optional, free, recommended ─
# Enable "PageSpeed Insights API" in Google Cloud + create an API key.
# Without it, speed scores are skipped (the keyless quota is unusable).
PAGESPEED_API_KEY=""

# ── AI provider (Phase 3: Writer) — pick one ────────────────
# Groq (free, fast, Llama): https://console.groq.com/keys
GROQ_API_KEY=""
# GROQ_MODEL="llama-3.3-70b-versatile"
# Or Gemini (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.0-flash"
# Upgrade path (use Claude instead): ANTHROPIC_API_KEY="..."

# ── Email sending (automated, via SMTP) ─────────────────────
# Gmail App Password (free): Google Account → Security →
#   2-Step Verification → App passwords → generate one → paste as SMTP_PASS.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="you@gmail.com"
SMTP_PASS=""
SMTP_FROM_EMAIL="you@gmail.com"
SMTP_FROM_NAME="Your Name"
# Read replies (inbox) over IMAP — reuses SMTP_USER + SMTP_PASS to log in.
# Gmail: imap.gmail.com · Zoho India: imap.zoho.in · Zoho.com: imap.zoho.com
# (Enable IMAP access in your mail provider's settings first.)
IMAP_HOST=""
IMAP_PORT="993"

# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
